# Supabase — copy this file to .env.local and fill in your project's values.
# Find both of these in your Supabase project: Settings → API.

# Your project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "public" key — safe to expose to the browser. It has no
# power on its own; every table is protected by Row Level Security
# (see supabase/schema.sql), so this key can only do what those policies
# allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key — SERVER-ONLY, bypasses Row Level Security.
# Required for one thing only: /admin/team/create creating a new sales
# team member's Supabase Auth account (src/lib/supabase/admin.ts). Never
# add the NEXT_PUBLIC_ prefix to this one, never reference it from a
# Client Component, and never commit its real value. Find it in your
# Supabase project: Settings → API → service_role (click Reveal).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Meta WhatsApp Business Cloud API — OPTIONAL, not required today.
#
# WhatsApp messaging currently works entirely via normal wa.me
# click-to-chat links (no credentials needed). These four vars are only
# for the FUTURE official Meta Cloud API integration (see
# src/services/whatsappService.ts and src/app/api/whatsapp/webhook).
# Leave them blank until you actually have Meta Business/App credentials
# — never put them in any client-side code.
# ---------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=
# Only needed once you register the webhook URL with Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------
# SEO & Analytics — OPTIONAL. The site works fully without any of these;
# they only turn on Google Search Console verification and Google
# Analytics 4 once you actually have the values below.
# ---------------------------------------------------------------------

# Google Search Console → Settings → Ownership verification → HTML tag
# method → copy just the "content" value of the meta tag (a long string,
# not the whole <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 → Admin → Data Streams → your web stream → the
# "Measurement ID", formatted like G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=

# NOT currently used — the site's maps (Contact page, property/project
# location) use a plain Google Maps embed URL that needs no API key.
# Only set this if you later switch to the interactive Google Maps
# JavaScript API. Get one at https://console.cloud.google.com/google/maps-apis
# (requires billing enabled) and restrict it to your domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------
# Map Provider (STEP 16) — OPTIONAL. The property map at /properties
# (List/Map/Split view) works out of the box using OpenStreetMap tiles
# via Leaflet — no key, no billing, nothing to configure. Only set these
# if you deliberately switch providers later (see src/lib/map.ts).
# ---------------------------------------------------------------------
# "osm" (default if unset) | "google" | "mapbox"
NEXT_PUBLIC_MAP_PROVIDER=
# Only read if NEXT_PUBLIC_MAP_PROVIDER=google — see the Google Maps
# section further up this file for how to get one.
# (reuses NEXT_PUBLIC_GOOGLE_MAPS_API_KEY above)
# Only read if NEXT_PUBLIC_MAP_PROVIDER=mapbox.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---------------------------------------------------------------------
# Marketing Platform APIs (STEP 15) — NOT CONNECTED. The Marketing
# Command Center tracks campaign performance and lead attribution using
# only this app's own Supabase data (UTM params, campaign_events,
# leads) — it never claims a live connection to any ad platform. These
# vars exist purely as the wiring point for a FUTURE integration (see
# src/lib/integrations/); until they're set, every card on
# /admin/marketing shows "Integration not configured." and nothing
# tries to call out to these platforms.
# ---------------------------------------------------------------------
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=
# Distinct from NEXT_PUBLIC_GA_ID above (that one just loads gtag.js in
# the browser) — this would be a server-side service account for pulling
# GA4 reporting data into the admin dashboard. Not implemented yet.
GOOGLE_ANALYTICS_SERVICE_ACCOUNT_JSON=
