# Supabase — copy this file to .env.local and fill in your project's values.
# Find both of these in your Supabase project: Settings → API.

# Your project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "public" key — safe to expose to the browser. It has no
# power on its own; every table is protected by Row Level Security
# (see supabase/schema.sql), so this key can only do what those policies
# allow. NEVER put the "service_role" key here or anywhere in this project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
