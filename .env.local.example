# Admin dashboard login — no passwords live in frontend code.
# Copy this file to .env.local and fill in your own values.

# The email the admin logs in with.
ADMIN_EMAIL=admin@5starm.com

# A bcrypt hash of the admin password — never the plain password itself.
# Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password-here', 10))"
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
